{
    "name": "browsersmith",
    "version": "0.0.8",
    "private": false,
    "description": "Browsersmith \u2014 browser-identical TLS + HTTP fingerprints behind a single fetch(), composing the browsercore networking stack.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "files": [
        "dist",
        "bin"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsersmith.git"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint --type-aware src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "example": "tsx",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build",
        "docs": "typedoc"
    },
    "dependencies": {
        "@browsercore/compression": "^0.2.1",
        "@browsercore/contracts": "^0.2.2",
        "@browsercore/cookies": "^0.2.0",
        "@browsercore/crypto": "^0.2.2",
        "@browsercore/fetch": "^0.2.6",
        "@browsercore/http1": "^0.2.1",
        "@browsercore/http2": "^0.2.3",
        "@browsercore/http3": "^0.1.8",
        "@browsercore/profiles": "^0.2.0",
        "@browsercore/quic": "^0.2.3",
        "@browsercore/tls": "^0.4.3",
        "@browsercore/transport": "^0.2.5"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "tsx": "^4.19.0",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "@browsercore/transport": "^0.2.5",
        "@browsercore/tls": "^0.4.3"
    }
}
