{
    "name": "browsersmith",
    "version": "0.0.18",
    "private": false,
    "description": "Browsersmith — browser-identical TLS + HTTP fingerprints behind a single fetch(), composing the browsercore networking stack.",
    "license": "MIT",
    "keywords": [
        "crawlee",
        "web-scraping",
        "scraping",
        "crawler",
        "anti-detection",
        "tls-fingerprint",
        "ja3",
        "ja4",
        "http2",
        "impersonation",
        "socks5",
        "proxy",
        "serverless",
        "deno",
        "bun"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "files": [
        "dist",
        "bin"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsersmith.git"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint --type-aware src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "example": "tsx",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build",
        "docs": "typedoc"
    },
    "dependencies": {
        "@browsercore/compression": "^0.2.1",
        "@browsercore/contracts": "^0.2.5",
        "@browsercore/cookies": "^0.2.0",
        "@browsercore/crypto": "^0.2.6",
        "@browsercore/fetch": "^0.2.24",
        "@browsercore/http1": "0.2.5",
        "@browsercore/http2": "^0.2.13",
        "@browsercore/http3": "^0.1.8",
        "@browsercore/profiles": "^0.2.5",
        "@browsercore/proxy": "^0.1.3",
        "@browsercore/quic": "^0.2.4",
        "@browsercore/tls": "^0.4.16",
        "@browsercore/transport": "^0.2.9"
    },
    "devDependencies": {
        "@browsercore/testing": "^0.2.7",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2007",
        "tsx": "^4.19.0",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "@browsercore/contracts": "^0.2.5",
        "@browsercore/crypto": "^0.2.6",
        "@browsercore/fetch": "^0.2.24",
        "@browsercore/http1": "0.2.5",
        "@browsercore/http2": "^0.2.13",
        "@browsercore/profiles": "^0.2.5",
        "@browsercore/proxy": "^0.1.3",
        "@browsercore/tls": "^0.4.16",
        "@browsercore/transport": "^0.2.9"
    }
}
