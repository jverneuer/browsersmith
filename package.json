{
    "name": "browsersmith",
    "version": "0.0.0",
    "private": false,
    "description": "Browsersmith — browser-identical TLS + HTTP fingerprints behind a single fetch(), composing the browsercore networking stack.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsersmith.git"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint --type-aware src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "example": "tsx",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "dependencies": {
        "@browsercore/compression": "0.2.0",
        "@browsercore/cookies": "0.2.0",
        "@browsercore/crypto": "0.2.0",
        "@browsercore/fetch": "0.2.0",
        "@browsercore/http1": "0.2.0",
        "@browsercore/http2": "0.2.0",
        "@browsercore/http3": "0.2.0",
        "@browsercore/profiles": "0.2.0",
        "@browsercore/quic": "0.2.1",
        "@browsercore/tls": "0.2.0",
        "@browsercore/transport": "0.2.0"
    },
    "devDependencies": {
        "@browsercore/dev": "latest",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "tsx": "^4.19.0",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    }
}
