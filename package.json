{
  "name": "browsercore",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-facing entrypoint for the browsercore networking and impersonation stack — browser-identical TLS + HTTP fingerprints behind a single fetch().",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@browsercore/compression": "^0.1.2",
    "@browsercore/cookies": "^0.1.5",
    "@browsercore/crypto": "^0.1.4",
    "@browsercore/fetch": "^0.1.3",
    "@browsercore/http1": "^0.1.4",
    "@browsercore/http2": "^0.1.4",
    "@browsercore/profiles": "^0.1.4",
    "@browsercore/tls": "^0.1.3",
    "@browsercore/transport": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
