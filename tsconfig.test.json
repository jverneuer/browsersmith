{
    // Dual typecheck gate (run by `npm run typecheck`): compiles src/ AND the
    // tests so vitest's transpile-only run can no longer hide type errors in
    // test files. examples/ are typechecked-adjacent consumer code — they
    // import test fixtures, so they belong in the test program, not the build.
    //
    // `exclude` is OVERRIDDEN here on purpose: it is inherited from
    // ./tsconfig.json, whose exclude list drops "tests" — without this
    // override the `include` below would match nothing and the gate would
    // silently typecheck zero test files.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": "."
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
